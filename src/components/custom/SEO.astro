---
import type { ImageMetadata } from 'astro';

interface Props {
  title?: string;
  description?: string;
  image?: ImageMetadata | string;
  article?: boolean;
  publishedDate?: Date;
  noindex?: boolean;
  structuredData?: Record<string, any> | Array<Record<string, any>>;
}

const {
  title = 'AzBagas - Personal Blog',
  description = 'Azhar Bagaskara (AzBagas) - Backend Engineer specializing in scalable server-side systems, robust APIs, Docker, Laravel, and system design.',
  image,
  article = false,
  publishedDate,
  noindex = false,
  structuredData,
} = Astro.props;

const site = Astro.site ?? new URL('https://azbagas.com');
const canonicalURL = new URL(Astro.url.pathname, site);

let ogImageUrl: string;
if (!image) {
  ogImageUrl = new URL('/android-chrome-512x512.png', site).toString();
} else if (typeof image === 'string') {
  ogImageUrl = image.startsWith('http') ? image : new URL(image, site).toString();
} else {
  ogImageUrl = new URL(image.src, site).toString();
}

// Base person & website JSON-LD schema
const basePersonSchema = {
  '@type': 'Person',
  '@id': 'https://azbagas.com/#person',
  'name': 'Azhar Bagaskara',
  'alternateName': ['AzBagas', 'Bagas'],
  'jobTitle': 'Backend Engineer',
  'url': 'https://azbagas.com',
  'image': new URL('/android-chrome-512x512.png', site).toString(),
  'sameAs': [
    'https://github.com/azbagas',
    'https://www.linkedin.com/in/azhar-bagaskara/',
    'https://www.facebook.com/profile.php?id=100008209996672',
  ],
  'alumniOf': {
    '@type': 'EducationalOrganization',
    'name': 'Universitas Gadjah Mada',
  },
  'knowsAbout': [
    'Backend Engineering',
    'System Design',
    'REST APIs',
    'PHP',
    'Laravel',
    'TypeScript',
    'Docker',
    'MySQL',
    'Go',
  ],
};

const baseWebSiteSchema = {
  '@type': 'WebSite',
  '@id': 'https://azbagas.com/#website',
  'url': 'https://azbagas.com',
  'name': 'AzBagas',
  'publisher': { '@id': 'https://azbagas.com/#person' },
};

const schemas: any[] = [basePersonSchema, baseWebSiteSchema];

if (article && publishedDate) {
  schemas.push({
    '@type': 'BlogPosting',
    'headline': title,
    'description': description,
    'image': ogImageUrl,
    'datePublished': publishedDate.toISOString(),
    'dateModified': publishedDate.toISOString(),
    'mainEntityOfPage': {
      '@type': 'WebPage',
      '@id': canonicalURL.toString(),
    },
    'author': { '@id': 'https://azbagas.com/#person' },
    'publisher': { '@id': 'https://azbagas.com/#person' },
  });
}

if (structuredData) {
  if (Array.isArray(structuredData)) {
    schemas.push(...structuredData);
  } else {
    schemas.push(structuredData);
  }
}

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': schemas,
};
---

<!-- Global Metadata -->
<meta name="description" content={description} />
<meta name="author" content="Azhar Bagaskara" />
<link rel="canonical" href={canonicalURL} />
{noindex && <meta name="robots" content="noindex, nofollow" />}
<link rel="alternate" type="application/rss+xml" title="AzBagas Blog RSS Feed" href="/rss.xml" />

<!-- Preconnect to external assets -->
<link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
<link rel="dns-prefetch" href="https://cdn.jsdelivr.net" />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={article ? 'article' : 'website'} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:site_name" content="AzBagas" />
<meta property="og:locale" content="en_US" />
{article && publishedDate && (
  <meta property="article:published_time" content={publishedDate.toISOString()} />
  <meta property="article:author" content="Azhar Bagaskara" />
)}

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalURL} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />

<!-- Structured Data (JSON-LD) -->
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
