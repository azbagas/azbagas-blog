<style type="text/css" media="screen" is:inline>
  .gr_grid_container {
    /* customize grid container div here. eg: width: 500px; */
    height: auto;
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
    justify-content: space-between;
  }

  .gr_grid_container.gr_grid_centered {
    justify-content: center;
    row-gap: 10px;
  }

  .gr_grid_container br {
    display: none;
  }

  .gr_grid_book_container {
    /* customize book cover container div here */
    /* float: left; */
    width: 98px;
    height: 160px;
    padding: 0px 0px;
    overflow: hidden;
  }

  .gr_grid_book_container img {
    border-radius: 6px;
  }

  .gr_grid_branding {
    display: none;
  }
</style>

<div id="gr_grid_widget_1759908030" class="mt-4"></div>
<a
  href="https://www.goodreads.com/user/show/189255530-azhar-bagaskara"
  target="_blank"
  class="underline block mt-4 text-right">See more on Goodreads »</a
>

<script
  is:inline
  src="https://www.goodreads.com/review/grid_widget/189255530.Azhar's%20bookshelf:%20read?cover_size=medium&hide_link=&hide_title=true&num_books=14&order=d&shelf=read&sort=date_read&widget_id=1759908030"
  type="text/javascript"
  charset="utf-8"></script>

<script>
  document.querySelectorAll('.gr_grid_book_container a').forEach((el) => {
    el.setAttribute('target', '_blank');
  });

  const gridContainer = document.querySelector<HTMLElement>('.gr_grid_container');
  if (gridContainer) {
    const updateGridAlignment = () => {
      const books = gridContainer.querySelectorAll('.gr_grid_book_container');
      if (!books.length) return;
      const bookWidth = 98;
      const defaultGap = 5;
      const containerWidth = gridContainer.clientWidth;
      const itemsPerRow = Math.max(
        1,
        Math.floor((containerWidth + defaultGap) / (bookWidth + defaultGap))
      );
      const rows = Math.ceil(books.length / itemsPerRow);
      const shouldCenter = rows > 1 && books.length % itemsPerRow !== 0;

      gridContainer.classList.toggle('gr_grid_centered', shouldCenter);
      if (shouldCenter && itemsPerRow > 1) {
        const exactGap = Math.max(
          defaultGap,
          (containerWidth - itemsPerRow * bookWidth - 0.5) / (itemsPerRow - 1)
        );
        gridContainer.style.columnGap = `${exactGap}px`;
      } else {
        gridContainer.style.columnGap = '';
      }
    };

    updateGridAlignment();
    new ResizeObserver(updateGridAlignment).observe(gridContainer);
  }
</script>
